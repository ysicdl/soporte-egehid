<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SoporteEgehid</RootNamespace>
    <AssemblyName>SoporteEgehid</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- Las vistas HTML viven en la raíz del repo; se copian al publicar. -->
  <ItemGroup>
    <Content Include="..\monitoreo.html" Link="monitoreo.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\forms_soporte_ui.html" Link="forms_soporte_ui.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
