<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de IIS para servir la app FastAPI mediante HttpPlatformHandler.
  IIS levanta un proceso uvicorn y le asigna un puerto en %HTTP_PLATFORM_PORT%;
  luego hace de proxy inverso hacia 127.0.0.1:ESE_PUERTO.

  REQUISITOS EN EL SERVIDOR (ver DESPLIEGUE_IIS.md):
    1. Python instalado (ajusta processPath a tu ruta real o al venv).
    2. Módulo "HttpPlatformHandler" instalado en IIS.
    3. Dependencias instaladas:  python -m pip install -r requirements.txt
    4. La identidad del Application Pool con permiso de ESCRITURA sobre la
       carpeta de la app (o sobre SOPORTE_DB_PATH) para el archivo SQLite
       y sus .db-wal / .db-shm.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform processPath="C:\Python312\python.exe"
                  arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <!-- Opcional: mover la BD a una carpeta de datos con permisos de escritura.
        <environmentVariable name="SOPORTE_DB_PATH" value="C:\datos\soporte-egehid\soporte.db" />
        -->
        <!-- Opcional: orígenes CORS extra si consumes la API desde otro sitio.
        <environmentVariable name="ALLOWED_ORIGINS" value="https://intranet.egehid.gob.do" />
        -->
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
